{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/services/category/:categoryId/:categorySlug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "facebookexternalhit|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Googlebot|Applebot|Bingbot|Discordbot|redditbot|Pinterest"
        }
      ],
      "destination": "/api/category-meta/:categoryId/:categorySlug"
    },
    {
      "source": "/services",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "facebookexternalhit|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Googlebot|Applebot|Bingbot|Discordbot|redditbot|Pinterest"
        }
      ],
      "destination": "/api/public-page-meta/services"
    },
    {
      "source": "/about",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "facebookexternalhit|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Googlebot|Applebot|Bingbot|Discordbot|redditbot|Pinterest"
        }
      ],
      "destination": "/api/public-page-meta/about"
    },
    {
      "source": "/gallery",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "facebookexternalhit|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Googlebot|Applebot|Bingbot|Discordbot|redditbot|Pinterest"
        }
      ],
      "destination": "/api/public-page-meta/gallery"
    },
    {
      "source": "/contact",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "facebookexternalhit|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Googlebot|Applebot|Bingbot|Discordbot|redditbot|Pinterest"
        }
      ],
      "destination": "/api/public-page-meta/contact"
    },
    {
      "source": "/service/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "facebookexternalhit|Twitterbot|WhatsApp|LinkedInBot|Slackbot|TelegramBot|Googlebot|Applebot|Bingbot|Discordbot|redditbot|Pinterest"
        }
      ],
      "destination": "/api/service-meta/:slug"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
